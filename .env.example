# Copy this file to .env.local and fill in values. Never commit .env files.

# Anthropic API key for the app's live AI features (Phase 5).
# Get one at console.anthropic.com. It is only ever read on the server.
ANTHROPIC_API_KEY=

# Postgres connection string from Vercel's Neon integration (Phase 8).
# Leave empty locally: the app then uses a local PGlite database in .data/
DATABASE_URL=
